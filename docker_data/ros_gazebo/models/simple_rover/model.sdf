<?xml version='1.0'?>
<sdf version='1.6'>
  <model name="simple_rover">
    <pose>0 0 0.2 0 0 0</pose>

    <!-- Main Chassis -->
    <link name="base_link">
      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.8</iyy>
          <iyz>0</iyz>
          <izz>0.5</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>0.6 0.4 0.15</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>1e5</kp>
              <kd>10.0</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.005</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="chassis_visual">
        <geometry>
          <box>
            <size>0.6 0.4 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.6 1</ambient>
          <diffuse>0.2 0.2 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- IMU Sensor -->
    <link name="imu_link">
      <pose>0 0 0.1877 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-6</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-6</iyy>
          <iyz>0</iyz>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>200.0</update_rate>

        <imu>
          <angular_velocity>
            <x><noise type="none"/></x>
            <y><noise type="none"/></y>
            <z><noise type="none"/></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="none"/></x>
            <y><noise type="none"/></y>
            <z><noise type="none"/></z>
          </linear_acceleration>
        </imu>

        <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <topicName>/imu/data</topicName>
          <bodyName>imu_link</bodyName>
          <updateRateHZ>200.0</updateRateHZ>
          <gaussianNoise>0.0</gaussianNoise>
          <xyzOffset>0 0 0</xyzOffset>
          <rpyOffset>0 0 0</rpyOffset>
          <frameName>imu_link</frameName>
          <initialOrientationAsReference>false</initialOrientationAsReference>
        </plugin>
      </sensor>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <!-- Camera for FAST-LIVO2 (facing -X = driving direction) -->
    <link name="camera_link">
      <pose>-0.32 0 0.12 0 0 3.141593</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="camera_visual">
        <geometry>
          <box>
            <size>0.03 0.06 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <collision name="camera_collision">
        <geometry>
          <box>
            <size>0.03 0.06 0.03</size>
          </box>
        </geometry>
      </collision>
      <sensor name="front_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.5707963</horizontal_fov>
          <image>
            <width>1280</width>
            <height>960</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>30.0</updateRate>
          <cameraName>front_camera</cameraName>
          <imageTopicName>/camera/image_raw</imageTopicName>
          <cameraInfoTopicName>/camera/camera_info</cameraInfoTopicName>
          <frameName>camera_link</frameName>
          <hackBaseline>0.0</hackBaseline>
          <distortionK1>0.0</distortionK1>
          <distortionK2>0.0</distortionK2>
          <distortionK3>0.0</distortionK3>
          <distortionT1>0.0</distortionT1>
          <distortionT2>0.0</distortionT2>
        </plugin>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- Velodyne VLP-16 LiDAR Base -->
    <link name="velodyne_base_link">
      <pose>0 0 0.15 0 0 0</pose>
      <inertial>
        <mass>0.83</mass>
        <inertia>
          <ixx>0.000908</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000908</iyy>
          <iyz>0</iyz>
          <izz>0.001104</izz>
        </inertia>
      </inertial>
      <visual name="velodyne_base_visual">
        <geometry>
          <cylinder>
            <radius>0.0516</radius>
            <length>0.0717</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <collision name="velodyne_base_collision">
        <geometry>
          <cylinder>
            <radius>0.0516</radius>
            <length>0.0717</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
    <joint name="velodyne_base_joint" type="fixed">
      <parent>base_link</parent>
      <child>velodyne_base_link</child>
    </joint>

    <!-- Velodyne VLP-16 Scan Head -->
    <link name="velodyne">
      <pose>0 0 0.1877 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-7</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-7</iyy>
          <iyz>0</iyz>
          <izz>1e-7</izz>
        </inertia>
      </inertial>
      <visual name="velodyne_scan_visual">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.0 0.8 1</ambient>
          <diffuse>0.0 0.0 0.8 1</diffuse>
        </material>
      </visual>
      <sensor type="gpu_ray" name="velodyne_vlp16">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>40</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1875</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415926</min_angle>
              <max_angle>3.1415926</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.0873</min_angle>
              <max_angle>0.4363</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.3</min>
            <max>131.0</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0</stddev>
          </noise>
        </ray>
        <plugin name="gazebo_ros_velodyne_laser" filename="libgazebo_ros_velodyne_gpu_laser.so">
          <topicName>/velodyne_points_raw</topicName>
          <frameName>velodyne</frameName>
          <min_range>0.3</min_range>
          <max_range>130.0</max_range>
          <gaussianNoise>0</gaussianNoise>
        </plugin>
      </sensor>
    </link>
    <joint name="velodyne_scan_joint" type="fixed">
      <parent>velodyne_base_link</parent>
      <child>velodyne</child>
    </joint>

    <!-- ============== FRONT DRIVEN WHEELS (tank steer) ============== -->

    <!-- Front Left Wheel (driven by left stick) -->
    <link name="front_left_wheel">
      <pose>0.2 0.25 0 1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.005</iyy>
          <iyz>0</iyz>
          <izz>0.008</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e5</kp>
              <kd>10.0</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.005</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics>
          <damping>1.0</damping>
          <friction>0.5</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Front Right Wheel (driven by right stick) -->
    <link name="front_right_wheel">
      <pose>0.2 -0.25 0 1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.005</iyy>
          <iyz>0</iyz>
          <izz>0.008</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e5</kp>
              <kd>10.0</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.005</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics>
          <damping>1.0</damping>
          <friction>0.5</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- ============== REAR WHEELS (free-spinning, not driven) ============== -->

    <!-- Back Left Wheel (free-spinning) -->
    <link name="back_left_wheel">
      <pose>-0.2 0.25 0 1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.005</iyy>
          <iyz>0</iyz>
          <izz>0.008</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e5</kp>
              <kd>10.0</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.005</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="back_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>back_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics>
          <damping>1.0</damping>
          <friction>0.5</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Back Right Wheel (free-spinning) -->
    <link name="back_right_wheel">
      <pose>-0.2 -0.25 0 1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.005</iyy>
          <iyz>0</iyz>
          <izz>0.008</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e5</kp>
              <kd>10.0</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.005</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="back_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>back_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics>
          <damping>1.0</damping>
          <friction>0.5</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- ArduPilot Plugin - 4WD Arcade steering -->
    <plugin name="ardupilot_plugin" filename="libArduPilotPlugin.so">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <fdm_port_out>9003</fdm_port_out>
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED>0 0 0 3.141593 0 0</gazeboXYZToNED>
      <imuName>simple_rover::imu_link::imu_sensor</imuName>
      <connectionTimeoutMaxCount>50</connectionTimeoutMaxCount>

      <!-- Front Left Wheel (channel 0 = left side) -->
      <control channel="0">
        <type>VELOCITY</type>
        <offset>0</offset>
        <p_gain>1</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>100</cmd_max>
        <cmd_min>-100</cmd_min>
        <jointName>front_left_wheel_joint</jointName>
        <multiplier>75</multiplier>
      </control>

      <!-- Front Right Wheel (channel 2 = right side) -->
      <control channel="2">
        <type>VELOCITY</type>
        <offset>0</offset>
        <p_gain>1</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>100</cmd_max>
        <cmd_min>-100</cmd_min>
        <jointName>front_right_wheel_joint</jointName>
        <multiplier>75</multiplier>
      </control>

      <!-- Back Left Wheel (channel 0 = left side, same as front left) -->
      <control channel="0">
        <type>VELOCITY</type>
        <offset>0</offset>
        <p_gain>1</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>100</cmd_max>
        <cmd_min>-100</cmd_min>
        <jointName>back_left_wheel_joint</jointName>
        <multiplier>75</multiplier>
      </control>

      <!-- Back Right Wheel (channel 2 = right side, same as front right) -->
      <control channel="2">
        <type>VELOCITY</type>
        <offset>0</offset>
        <p_gain>1</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>100</cmd_max>
        <cmd_min>-100</cmd_min>
        <jointName>back_right_wheel_joint</jointName>
        <multiplier>75</multiplier>
      </control>

    </plugin>

  </model>
</sdf>
