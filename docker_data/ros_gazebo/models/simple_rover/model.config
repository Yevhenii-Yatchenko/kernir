<?xml version='1.0'?>
<model>
  <name>Simple Rover</name>
  <version>2.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <description>
    4-wheel skid-steer rover for ArduPilot SITL with FAST-LIVO2 sensors.
