<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="flat_rover">

    <!-- Physics settings for ArduPilot synchronization -->
    <physics type="ode">
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.0</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.9</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.0</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>0</real_time_update_rate>
      <max_step_size>0.0025</max_step_size>
    </physics>

    <!-- Sun -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Spawn simple rover -->
    <include>
      <uri>model://simple_rover</uri>
      <pose>0 0 0.2 0 0 0</pose>
    </include>

  </world>
</sdf>
