<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="willowgarage_rover">

    <!-- Physics settings for ArduPilot synchronization -->
    <physics type="ode">
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.0</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.9</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.0</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>0</real_time_update_rate>
      <max_step_size>0.0025</max_step_size>
    </physics>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Willow Garage office building -->
    <include>
      <uri>model://willowgarage</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Spawn rover inside the building -->
    <include>
      <uri>model://simple_rover</uri>
      <pose>-3 0 0.5 0 0 0</pose>
    </include>

  </world>
</sdf>
