# Arcade 4WD Skid Steering Configuration
# Load with: param load /params/arcade_4wd.parm

# Steering type: Arcade (single stick - direction + throttle)
PILOT_STEER_TYPE 0    # 0=arcade (was 2, which is invalid)

# Left motors (channel 1 = SERVO1 = Gazebo channel 0)
SERVO1_FUNCTION 73    # ThrottleLeft
SERVO1_MIN 1000
SERVO1_MAX 2000
SERVO1_TRIM 1500

# Right motors (channel 3 = SERVO3 = Gazebo channel 2)
SERVO3_FUNCTION 74    # ThrottleRight

# Reverse steering input (fix inverted left-right)
RC1_REVERSED 1
SERVO3_MIN 1000
SERVO3_MAX 2000
SERVO3_TRIM 1500
#SERVO3_REVERSED 1     # Reverse direction

# Skid steering settings
TURN_RADIUS 0.5       # Tight turning (meters)
PIVOT_TURN_RATE 60    # Pivot turn rate deg/s

# Speed/Throttle tuning
ATC_SPEED_P 0.4
ATC_SPEED_I 0.2
ATC_SPEED_D 0.0
CRUISE_SPEED 2.0      # Target cruise speed m/s
CRUISE_THROTTLE 30    # Throttle % at cruise speed

# Simulation settings
AHRS_EKF_TYPE 3       # Use EKF3
EK3_ENABLE 1
EK3_SRC1_POSXY 0      # None (GPS disabled for indoor sim)
EK3_SRC1_VELXY 0
EK3_SRC1_POSZ 1       # Baro
EK3_SRC1_VELZ 0
EK3_SRC1_YAW 1        # Compass


ARMING_REQUIRE 1
MOT_SAFE_DISARM 1