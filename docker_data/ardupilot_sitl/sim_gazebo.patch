diff --git a/libraries/SITL/SIM_Gazebo.cpp b/libraries/SITL/SIM_Gazebo.cpp
--- a/libraries/SITL/SIM_Gazebo.cpp
+++ b/libraries/SITL/SIM_Gazebo.cpp
@@ -107,7 +107,10 @@ void Gazebo::send_servos(const struct sitl_input &input)
     // 16 because struct sitl_input.servos is 16 large in SIM_Aircraft.h
     for (unsigned i = 0; i < 16; ++i)
     {
-      pkt.motor_speed[i] = (input.servos[i]-1000) / 1000.0f;
+      // Center at 1500 (neutral) -> 0.0, range -1.0 to +1.0
+      // Treat 0 (no signal) as neutral
+      uint16_t pwm = input.servos[i];
+      pkt.motor_speed[i] = (pwm == 0) ? 0.0f : (pwm - 1500) / 500.0f;
     }
     socket_sitl.sendto(&pkt, sizeof(pkt), _gazebo_address, _gazebo_port);
 }
